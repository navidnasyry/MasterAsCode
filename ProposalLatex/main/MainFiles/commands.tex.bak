%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%برای اضافه کردن علامت - بعد از اعداد (مورد استفاده در بخش)
‎\makeatletter‎
‎\renewcommand{\SepMark}[1]{\def\@SepMark{#1}\quad}‎
‎\renewcommand{\thesection}{\arabic{section}\@SepMark\hspace*{-6pt}}‎
‎\renewcommand{\thesubsection}{\arabic{section}\@SepMark\arabic{subsection}\@SepMark\hspace*{-6pt}}‎
‎\makeatother‎
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%تنظیمات اندازه فونت بخش و زیربخش
‎\titleformat*{\section}{\bfseries\fontsize{10}{11}\selectfont}‎
‎\titleformat*{\subsection}{\bfseries\fontsize{10}{11}\selectfont}‎
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
‎%\titlespacing*{<command>}{<left>}{<before-sep>}{<after-sep>}‎
‎\titlespacing*{\section}{0pt}{0.3\baselineskip}{0.3\baselineskip}‎
‎\titlespacing*{\subsection}{0pt}{0.3\baselineskip}{0.3\baselineskip}‎
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%کاهش اندازه فاصله بین مراجع
