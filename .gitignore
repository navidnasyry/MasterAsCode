# Model directories and large files
# ============================================

# Ignore everything in AiModels/
AiModels/*

# ...except .zip files
!AiModels/*.zip

# ...and optionally keep subfolders (if you plan to unzip inside)
!AiModels/.gitkeep

# Ignore raw model files
*.h5
*.pkl
*.pt
*.pth
*.joblib
*.onnx
*.tflite
*.weights
*.ckpt
*.tar
*.gz

